PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=unitpro
DB_USER=root
DB_PASSWORD=unitpro_root_pw

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Vite falls back to the next free port if 5173 is taken — list a few to avoid dev friction
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@unitpro.fit
# Quote the value if it contains a "#" — dotenv treats an unquoted "#" as a comment start
SUPER_ADMIN_PASSWORD="change_me_now"
